// NEXTMIND — Prisma Schema (PostgreSQL)
// Entities: User, Programme, Registration, Enquiry

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(uuid())
  fullName      String
  email         String         @unique
  phone         String
  createdAt     DateTime       @default(now())
  registrations Registration[]

  @@index([email])
}

model Programme {
  id            String         @id @default(uuid())
  title         String
  slug          String         @unique
  description   String
  level         String
  duration      String
  isActive      Boolean        @default(true)
  registrations Registration[]

  @@index([slug])
}

model Registration {
  id                    String    @id @default(uuid())
  userId                String
  programmeId           String
  educationLevel        String    @default("Undergraduate Student")
  occupation            String?
  status                String    @default("CONFIRMED")
  registrationReference String    @unique
  createdAt             DateTime  @default(now())

  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  programme             Programme @relation(fields: [programmeId], references: [id], onDelete: Restrict)

  @@unique([userId, programmeId])
  @@index([programmeId])
  @@index([registrationReference])
}

model Enquiry {
  id                     String   @id @default(uuid())
  fullName               String
  email                  String
  phone                  String
  programmeInterest      String
  educationLevel         String
  preferredContactMethod String
  message                String?
  status                 String   @default("NEW")
  createdAt              DateTime @default(now())

  @@index([email])
  @@index([status])
  @@index([programmeInterest])
}

